{
  "id": "youtube-classic",
  "name": "Youtube Classic",
  "schemaVersion": 1,
  "captionLayout": {
    "textDirection": "auto",
    "rowsPerPage": {
      "mode": "all"
    },
    "wordsPerRow": {
      "mode": "auto"
    },
    "flowParticipation": {
      "collapseMode": "reserve",
      "rows": {
        "default": "include",
        "past": "include",
        "previous": "include",
        "current": "include",
        "next": "include",
        "future": "include"
      },
      "words": {
        "past": "include",
        "previous": "include",
        "current": "include",
        "next": "collapse",
        "future": "collapse"
      }
    },
    "horizontalFit": "natural",
    "horizontalFitMinScale": 0.5,
    "horizontalFitMaxScale": 1.25,
    "breaking": {
      "smartBreaks": "auto",
      "rowBreakPauseThresholdSeconds": 1,
      "pageBreakPauseThresholdSeconds": 2,
      "longWordThresholdMode": "automatic",
      "longWordThresholdSeconds": 0.75,
      "breakPriorities": {
        "rows": [
          {
            "id": "source",
            "mode": "prefer"
          },
          {
            "id": "punctuation",
            "mode": "always"
          },
          {
            "id": "pause",
            "mode": "prefer"
          },
          {
            "id": "word-count",
            "mode": "required"
          },
          {
            "id": "width",
            "mode": "required"
          },
          {
            "id": "long-word",
            "mode": "required"
          }
        ],
        "pages": [
          {
            "id": "source",
            "mode": "off"
          },
          {
            "id": "punctuation",
            "mode": "off"
          },
          {
            "id": "pause",
            "mode": "off"
          },
          {
            "id": "row-count",
            "mode": "required"
          },
          {
            "id": "height",
            "mode": "required"
          }
        ]
      },
      "wordWrapping": {
        "mode": "wrap",
        "breakCharacters": ["-"],
        "breakMarker": "-",
        "overflowTolerance": 8
      },
      "sentenceEndings": [".", "!", "?", "।", "॥", "。", "！", "？"],
      "strongPunctuation": [";", ":", "…", "；", "：", "……"],
      "additionalCharacters": [],
      "sourceLineBreaks": "allow-reflow"
    }
  },
  "stateWindow": {
    "previousWords": {
      "mode": "rowCount",
      "count": 1
    },
    "currentWords": {
      "mode": "fixedCount",
      "count": 1
    },
    "nextWords": {
      "mode": "currentRow"
    },
    "previousRows": {
      "mode": "fixedCount",
      "count": 1
    },
    "currentRows": {
      "mode": "fixedCount",
      "count": 1
    },
    "nextRows": {
      "mode": "fixedCount",
      "count": 1
    }
  },
  "timing": {
    "captionHoldThresholdSeconds": 1
  },
  "metadata": {
    "badges": ["ticker", "animated", "minimal"],
    "platform": "Youtube",
    "previewBackgroundId": "image-karaoke",
    "previewStoryId": "main-character"
