            "id": "source",
            "mode": "off"
          },
          {
            "id": "punctuation",
            "mode": "off"
          },
          {
            "id": "pause",
            "mode": "always"
          },
          {
            "id": "row-count",
            "mode": "required"
          },
          {
            "id": "height",
            "mode": "required"
          }
        ]
      },
      "wordWrapping": {
        "mode": "wrap",
        "breakCharacters": [
          "-"
        ],
        "breakMarker": "-",
        "overflowTolerance": 8
      },
      "sentenceEndings": [
        ".",
        "!",
        "?",
        "।",
        "॥",
        "。",
        "！",
        "？"
      ],
      "strongPunctuation": [
        ";",
        ":",
        "…",
        "；",
        "：",
        "……"
      ],
      "additionalCharacters": [],
      "sourceLineBreaks": "preserve"
    }
  },
  "stateWindow": {
