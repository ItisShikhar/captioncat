        "previous": "include",
        "current": "include",
        "next": "collapse",
        "future": "collapse"
      }
    },
    "horizontalFit": "natural",
    "horizontalFitMinScale": 0.5,
    "horizontalFitMaxScale": 1.25,
    "breaking": {
      "smartBreaks": "auto",
      "rowBreakPauseThresholdSeconds": 0.3,
      "pageBreakPauseThresholdSeconds": 2.5,
      "longWordThresholdMode": "automatic",
      "longWordThresholdSeconds": 0.75,
      "breakPriorities": {
        "rows": [
          {
            "id": "source",
            "mode": "always"
          },
          {
            "id": "punctuation",
            "mode": "prefer"
          },
          {
            "id": "pause",
            "mode": "always"
          },
          {
            "id": "word-count",
            "mode": "required"
          },
          {
            "id": "width",
            "mode": "required"
          },
          {
            "id": "long-word",
            "mode": "required"
          }
        ],
        "pages": [
